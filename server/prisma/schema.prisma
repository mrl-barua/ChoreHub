// Run: npx prisma migrate dev --name fcm_and_prefs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  displayName String   @map("display_name")
  email       String   @unique
  password    String
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  xp               Int       @default(0)
  level            Int       @default(1)
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastStreakEvalAt DateTime? @map("last_streak_eval_at")
  freezesAvailable Int       @default(0) @map("freezes_available")
  lastMendAt       DateTime? @map("last_mend_at")
  displayTitle     String?   @map("display_title")

  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?
  userBadges             UserBadge[]

  @@map("users")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  badgeKey String   @map("badge_key")
  earnedAt DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId])
  @@map("user_badges")
}

model Family {
  id        String   @id @default(uuid())
  name      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members FamilyMember[]
  chores  Chore[]

  @@map("families")
}

model FamilyMember {
  id       String   @id @default(uuid())
  familyId String   @map("family_id")
  userId   String   @map("user_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

model Invitation {
  id         String   @id @default(uuid())
  familyId   String   @map("family_id")
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("invitations")
}

model Chore {
  id                    String    @id @default(uuid())
  familyId              String    @map("family_id")
  title                 String
  category              String
  timeSlot              String?   @map("time_slot")
  assignedTo            String?   @map("assigned_to")
  status                String    @default("pending")
  assignmentStatus      String    @default("unassigned") @map("assignment_status")
  priority              String    @default("medium")
  description           String?
  recurrence            String?
  dueDate               DateTime? @map("due_date")
  dueSoonReminderSentAt DateTime? @map("due_soon_reminder_sent_at")
  createdBy             String    @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("chores")
}

model ChoreHistory {
  id        String   @id @default(uuid())
  choreId   String   @map("chore_id")
  familyId  String   @map("family_id")
  userId    String   @map("user_id")
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([familyId, action, createdAt])
  @@map("chore_history")
}

model ChoreComment {
  id        String   @id @default(uuid())
  choreId   String   @map("chore_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("chore_comments")
}

model Message {
  id        String    @id @default(uuid())
  familyId  String    @map("family_id")
  userId    String    @map("user_id")
  text      String
  choreId   String?   @map("chore_id")
  mentions  String?
  replyToId String?   @map("reply_to_id")
  imageUrl  String?   @map("image_url")
  reactions String? // JSON: {"emoji": ["userId1","userId2"]}
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("messages")
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  @@unique([messageId, userId])
  @@map("message_read_receipts")
}

model FamilyChallenge {
  id           String   @id @default(uuid())
  familyId     String   @map("family_id")
  title        String
  targetCount  Int      @map("target_count")
  currentCount Int      @default(0) @map("current_count")
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("family_challenges")
}

model ChoreSwapRequest {
  id         String   @id @default(uuid())
  choreId    String   @map("chore_id")
  fromUserId String   @map("from_user_id")
  toUserId   String?  @map("to_user_id")
  familyId   String   @map("family_id")
  status     String   @default("pending")
  message    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("chore_swap_requests")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  familyId  String   @map("family_id")
  type      String
  title     String
  body      String
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  pushEnabled     Boolean @default(true)
  choreAssigned   Boolean @default(true)
  choreCompleted  Boolean @default(true)
  choreDueSoon    Boolean @default(true)
  mention         Boolean @default(true)
  swap            Boolean @default(true)
  dailySummary    Boolean @default(true)
  quietHoursStart String? @default("22:00")
  quietHoursEnd   String? @default("07:00")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
